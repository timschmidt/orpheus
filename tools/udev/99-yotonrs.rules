# yotonrs developer channel and personalities (pid.codes test id 1209:0001,
# decision D-3), plus the Actions ids of the boot ROM, Rockbox and stock
# firmware. Grants the logged-in user access for `cargo xtask dev …`.
#
# Install:
#   sudo cp tools/udev/99-yotonrs.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="0001", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", SUBSYSTEM=="scsi_generic", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", SUBSYSTEM=="block", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="10d6", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="10d6", SUBSYSTEM=="scsi_generic", MODE="0666", TAG+="uaccess"
