# orpheus developer channel and personalities (pid.codes test id 1209:0001,
# decision D-3), plus the Actions ids of the boot ROM, Rockbox and stock
# firmware. Grants the logged-in user access for `cargo xtask dev …`.
#
# Install:
#   sudo cp tools/udev/99-orpheus.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="0001", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", SUBSYSTEM=="scsi_generic", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", SUBSYSTEM=="block", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="10d6", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="10d6", SUBSYSTEM=="scsi_generic", MODE="0666", TAG+="uaccess"

# The player's Bluetooth module as a HID keyboard (BlueZ, bus 0005, Actions
# vendor 10D6, product B009 from its PnP record): raw reports readable for
# the HIL tests (06 §4.3.3), and ignored by the desktop so test key reports
# never type into the user's windows.
# (uaccess is applied by 73-seat-late.rules, before this file runs, so the
# mode is opened like the USB rules above; only this device's reports.)
SUBSYSTEM=="hidraw", KERNELS=="0005:10D6:B009.*", MODE="0666"
SUBSYSTEM=="input", KERNELS=="0005:10D6:B009.*", ENV{LIBINPUT_IGNORE_DEVICE}="1"
